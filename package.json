{
  "name": "tcmaster",
  "private": true,
  "scripts": {
    "up": "docker compose -f infra/docker-compose.yml up --build",
    "down": "docker compose -f infra/docker-compose.yml down",
    "restart": "docker compose -f infra/docker-compose.yml down && docker compose -f infra/docker-compose.yml up --build",
    "logs": "docker compose -f infra/docker-compose.yml logs -f",
    "ps": "docker compose -f infra/docker-compose.yml ps"
  }
}
